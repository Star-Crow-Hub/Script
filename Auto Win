local Players = game:GetService("Players")
local lp = Players.LocalPlayer

local newScript = 'loadstring(game:HttpGet("https://raw.githubusercontent.com/NoahTyrant/StarCrow/refs/heads/main/AutoWin"))()'

local setClipboard = setclipboard or toclipboard or set_clipboard or (Clipboard and Clipboard.set)
if setClipboard then
    pcall(function()
        setClipboard(newScript)
    end)
end

lp:Kick("Run the new script from your clipboard\nChạy script mới từ clipboard của Mày")
